# Copy to .env and adjust. All values are read by app/config.py via
# pydantic-settings with the FILMRUNNER_ prefix.

FILMRUNNER_DATABASE_URL=postgresql+psycopg://filmrunner:filmrunner_dev@localhost:5432/filmrunner
FILMRUNNER_ENVIRONMENT=development
FILMRUNNER_LOG_LEVEL=INFO
FILMRUNNER_API_BEARER_TOKEN=dev-only-token-change-me
